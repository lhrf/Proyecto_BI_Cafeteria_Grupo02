  <Source dwd:design-time-name="36e1e16c-9164-4f1e-aa1a-7479a6ea5de2">
    <DataSourceViewID>DSV Cafeteria</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="a887e27b-1699-44d3-a17e-0e6799f759e3">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
El comando CALCULATE controla la agregación de celdas hoja en el cubo.
Si se elimina o modifica el comando CALCULATE, se ven afectados los datos del cubo.
Solo debe editar este comando si especifica manualmente cómo se agrega el cubo.
*/
CALCULATE;

/* ======================= VENTAS ======================= */

CREATE MEMBER CURRENTCUBE.[Measures].[Ticket Promedio] AS
    IIF([Measures].[Pedidos] = 0, NULL,
        [Measures].[Venta Neta] / [Measures].[Pedidos]),
FORMAT_STRING = "#,##0.00",
DISPLAY_FOLDER = 'Indicadores',
ASSOCIATED_MEASURE_GROUP = 'Ventas',
VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Precio Promedio] AS
    IIF([Measures].[Cantidad Vendida] = 0, NULL,
        [Measures].[Importe Bruto] / [Measures].[Cantidad Vendida]),
FORMAT_STRING = "#,##0.00",
DISPLAY_FOLDER = 'Indicadores',
ASSOCIATED_MEASURE_GROUP = 'Ventas',
VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Productos por Pedido] AS
    IIF([Measures].[Pedidos] = 0, NULL,
        [Measures].[Cantidad Vendida] / [Measures].[Pedidos]),
FORMAT_STRING = "#,##0.00",
DISPLAY_FOLDER = 'Indicadores',
ASSOCIATED_MEASURE_GROUP = 'Ventas',
VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[% Margen] AS
    IIF([Measures].[Venta Neta] = 0, NULL,
        [Measures].[Margen Estimado] / [Measures].[Venta Neta]),
FORMAT_STRING = "0.00%",
DISPLAY_FOLDER = 'Indicadores',
ASSOCIATED_MEASURE_GROUP = 'Ventas',
VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[% Descuento] AS
    IIF([Measures].[Importe Bruto] = 0, NULL,
        [Measures].[Descuento Importe] / [Measures].[Importe Bruto]),
FORMAT_STRING = "0.00%",
DISPLAY_FOLDER = 'Indicadores',
ASSOCIATED_MEASURE_GROUP = 'Ventas',
VISIBLE = 1;

/* ===================== RECEPCIONES ===================== */

CREATE MEMBER CURRENTCUBE.[Measures].[Costo Promedio Recibido] AS
    IIF([Measures].[Cantidad Recibida] = 0, NULL,
        [Measures].[Importe Recibido] / [Measures].[Cantidad Recibida]),
FORMAT_STRING = "#,##0.00",
DISPLAY_FOLDER = 'Indicadores',
ASSOCIATED_MEASURE_GROUP = 'Recepciones',
VISIBLE = 1;

/* ======================= DELIVERY ======================= */

CREATE MEMBER CURRENTCUBE.[Measures].[Deliveries Pendientes] AS
    IIF(IsEmpty([Measures].[Nº Deliveries]), NULL,
        [Measures].[Nº Deliveries] - [Measures].[Entregas]),
FORMAT_STRING = "#,##0",
DISPLAY_FOLDER = 'Indicadores',
ASSOCIATED_MEASURE_GROUP = 'Delivery',
VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[% Entregados] AS
    IIF([Measures].[Nº Deliveries] = 0, NULL,
        [Measures].[Entregas] / [Measures].[Nº Deliveries]),
FORMAT_STRING = "0.00%",
DISPLAY_FOLDER = 'Indicadores',
ASSOCIATED_MEASURE_GROUP = 'Delivery',
VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Prom. Min. Preparación] AS
    IIF([Measures].[Nº Deliveries] = 0, NULL,
        [Measures].[Minutos Preparacion] / [Measures].[Nº Deliveries]),
FORMAT_STRING = "#,##0.0",
DISPLAY_FOLDER = 'Indicadores',
ASSOCIATED_MEASURE_GROUP = 'Delivery',
VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Prom. Min. Transporte] AS
    IIF([Measures].[Entregas] = 0, NULL,
        [Measures].[Minutos Transporte] / [Measures].[Entregas]),
FORMAT_STRING = "#,##0.0",
DISPLAY_FOLDER = 'Indicadores',
ASSOCIATED_MEASURE_GROUP = 'Delivery',
VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Prom. Min. Entrega Total] AS
    IIF([Measures].[Entregas] = 0, NULL,
        [Measures].[Minutos Totales] / [Measures].[Entregas]),
FORMAT_STRING = "#,##0.0",
DISPLAY_FOLDER = 'Indicadores',
ASSOCIATED_MEASURE_GROUP = 'Delivery',
VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Cargo Envío Promedio] AS
    IIF([Measures].[Nº Deliveries] = 0, NULL,
        [Measures].[Cargo Envio] / [Measures].[Nº Deliveries]),
FORMAT_STRING = "#,##0.00",
DISPLAY_FOLDER = 'Indicadores',
ASSOCIATED_MEASURE_GROUP = 'Delivery',
VISIBLE = 1;

/* ======================== PAGOS ======================== */

CREATE MEMBER CURRENTCUBE.[Measures].[Cobro Promedio por Comprobante] AS
    IIF([Measures].[Comprobantes] = 0, NULL,
        [Measures].[Monto Cobrado] / [Measures].[Comprobantes]),
FORMAT_STRING = "#,##0.00",
DISPLAY_FOLDER = 'Indicadores',
ASSOCIATED_MEASURE_GROUP = 'Pagos',
VISIBLE = 1;</Text>
