    <DTS:Executable
      DTS:refId="Package\Calcular Filas Procesadas"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{7FECC08F-68D5-4511-9A28-C0C2DF92C093}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Calcular Filas Procesadas"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{78A102B0-7D9D-4ADC-A201-627414525FCF}"
          SQLTask:SqlStatementSource="DECLARE @IdControl bigint = ?;&#xA;&#xA;SELECT&#xA;      (SELECT COUNT_BIG(*)&#xA;       FROM dbo.FactVenta&#xA;       WHERE IdControlCarga = @IdControl)&#xA;&#xA;    + (SELECT COUNT_BIG(*)&#xA;       FROM dbo.FactRecepcionProducto&#xA;       WHERE IdControlCarga = @IdControl)&#xA;&#xA;    + (SELECT COUNT_BIG(*)&#xA;       FROM dbo.FactDelivery&#xA;       WHERE IdControlCarga = @IdControl&#xA;          OR IdControlActualizacion = @IdControl)&#xA;&#xA;    + (SELECT COUNT_BIG(*)&#xA;       FROM dbo.FactPago&#xA;       WHERE IdControlCarga = @IdControl)&#xA;       AS FilasProcesadas;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::FilasProcesadas" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::IdControl"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Carga Fecha de Inicio"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{0FAA3DAB-56C2-4D6F-8FC4-F40A0BA85481}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Carga Fecha de Inicio"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{78A102B0-7D9D-4ADC-A201-627414525FCF}"
          SQLTask:SqlStatementSource="SELECT&#xA;    COALESCE(&#xA;        UltimaFechaCarga,&#xA;        CONVERT(datetime2(0), '19000101', 112)&#xA;    ) AS FechaInicio&#xA;FROM dbo.ETL_Control&#xA;WHERE IdControl = ?;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::FechaInicio" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::IdControl"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
