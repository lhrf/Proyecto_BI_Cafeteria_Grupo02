                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">UPDATE dbo.DimEmpleado
SET
    Nombre = ?,
    Apellido = ?,
    RolIDOrigen = ?,
    Rol = ?,
    FechaIngreso = ?,
    Activo = ?
WHERE EmpleadoKey = ?;</property>
