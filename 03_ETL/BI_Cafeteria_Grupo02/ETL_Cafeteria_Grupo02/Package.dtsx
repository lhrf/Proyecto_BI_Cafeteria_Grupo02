          SQLTask:SqlStatementSource="exec dbo.SP_ETL_Inicio&#xA;@Proceso = ?,&#xA;@IdControl = ? output; " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
