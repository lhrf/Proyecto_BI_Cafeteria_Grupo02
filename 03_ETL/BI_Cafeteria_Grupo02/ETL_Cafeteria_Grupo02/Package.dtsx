    <DTS:Executable
      DTS:refId="Package\Poblar DimTiempo"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{7748B97C-2E6C-45C5-80CF-AA00CE7CD5C4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Poblar DimTiempo"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{78A102B0-7D9D-4ADC-A201-627414525FCF}"
          SQLTask:SqlStatementSource="DECLARE @FechaInicio date;&#xA;DECLARE @FechaFin date;&#xA;&#xA;;WITH FechasOrigen AS&#xA;(&#xA;    -- Fecha de los pedidos&#xA;    SELECT CONVERT(date, P.FechaHora) AS Fecha&#xA;    FROM Cafeteria.dbo.PedidoVenta AS P&#xA;&#xA;    UNION ALL&#xA;&#xA;    -- Fecha de recepción de productos&#xA;    SELECT I.Fecha&#xA;    FROM Cafeteria.dbo.IngresoProducto AS I&#xA;&#xA;    UNION ALL&#xA;&#xA;    -- Fecha de salida de los delivery&#xA;    SELECT CONVERT(date, D.FechaSalida)&#xA;    FROM Cafeteria.dbo.Delivery AS D&#xA;&#xA;    UNION ALL&#xA;&#xA;    -- Fecha de entrega de los delivery&#xA;    SELECT CONVERT(date, D.FechaEntrega)&#xA;    FROM Cafeteria.dbo.Delivery AS D&#xA;    WHERE D.FechaEntrega IS NOT NULL&#xA;&#xA;    UNION ALL&#xA;&#xA;    -- Fecha de los pagos&#xA;    SELECT CONVERT(date, PG.FechaHora)&#xA;    FROM Cafeteria.dbo.Pago AS PG&#xA;)&#xA;SELECT&#xA;    @FechaInicio =&#xA;        DATEFROMPARTS(YEAR(MIN(Fecha)), 1, 1),&#xA;&#xA;    @FechaFin =&#xA;        DATEFROMPARTS(YEAR(MAX(Fecha)), 12, 31)&#xA;FROM FechasOrigen;&#xA;&#xA;IF @FechaInicio IS NULL OR @FechaFin IS NULL&#xA;    THROW 52310, 'No existen fechas en Cafeteria para poblar DimTiempo.', 1;&#xA;&#xA;EXEC dbo.SP_Poblar_DimTiempo&#xA;    @FechaInicio = @FechaInicio,&#xA;    @FechaFin = @FechaFin;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::FechasInsertadas" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
